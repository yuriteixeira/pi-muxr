{
  "name": "pi-dash",
  "version": "0.1.0",
  "description": "tmux-native dashboard for pi coding-agent sessions",
  "type": "module",
  "packageManager": "pnpm@11.0.0-dev.1005",
  "bin": {
    "pi-dash": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./extension": "./dist/extension/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-sqlite --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.87.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/ws": "^8.18.1",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
